{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "snip-lab",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-03",
  "observability": {
    "enabled": true
  },
  // Static files in ./public are served directly. Only API calls and short
  // links (/s/<code>) run the Worker code.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/s/*"]
  },
  // No "id" on purpose: Wrangler creates the KV namespace locally on
  // `wrangler dev` and on Cloudflare on the first `wrangler deploy`.
  "kv_namespaces": [
    {
      "binding": "LINKS"
    }
  ]
}
